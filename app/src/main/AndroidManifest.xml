<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissão para acessar a Internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Grimório de Hogwarts"
        android:theme="@style/Theme.Grimorio">

        <activity
            android:name=".MenuActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PersonagemActivity"
            android:label="Busca de Personagem"
            android:screenOrientation="portrait" />

        <activity
            android:name=".CriaturaActivity"
            android:label="Busca de Criatura"
            android:screenOrientation="portrait" />
    </application>
</manifest>
